                </mxCell>
                <mxCell id="aWQv6UJ750VzHTLOqWvk-38" value="Let&#39;s not worry about People being added and removed, the lifecycle for this is out of scope." style="shape=note2;boundedLbl=1;whiteSpace=wrap;html=1;size=25;verticalAlign=top;align=center;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=0;fontSize=10;" parent="wVVx1cMErQA-93AqkkJT-1" vertex="1">
