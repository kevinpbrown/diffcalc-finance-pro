                </mxCell>
                <mxCell id="30" value="Note the semantic different in `getValue()` here versus every other usage: Here, it&#39;s a calculated value based on the current state of the four attributes. Everywhere else, it&#39;s a value from a timeline of previous values. That means that the `SimplePVGoalValue` is unique that any changes to it will retroactively affect all effective dates. If this becomes a problem, then we will need to handle it in the future." style="shape=note2;boundedLbl=1;whiteSpace=wrap;html=1;size=25;verticalAlign=top;align=center;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=0;fontSize=10;" parent="wVVx1cMErQA-93AqkkJT-1" vertex="1">
                    <mxGeometry x="988" y="1170" width="330" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="16" value="An InvestmentAccount can be committed to at most one goal. In the future, we can create a dated stack like we do for EffectiveAmount, but these rarely change so that&#39;d be overkill for now." style="shape=note2;boundedLbl=1;whiteSpace=wrap;html=1;size=25;verticalAlign=top;align=center;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" parent="wVVx1cMErQA-93AqkkJT-1" vertex="1">
                    <mxGeometry x="410" y="610" width="220" height="90" as="geometry"/>
