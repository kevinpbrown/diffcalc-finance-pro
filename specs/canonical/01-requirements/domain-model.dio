                </mxCell>
                <mxCell id="19" value="`GoalBankPortionAutoFill` willl automatically claim the difference between the goal value and the value of the allocated investment accounts from the current bank accounts." style="shape=note2;boundedLbl=1;whiteSpace=wrap;html=1;size=25;verticalAlign=top;align=center;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" parent="wVVx1cMErQA-93AqkkJT-1" vertex="1">
