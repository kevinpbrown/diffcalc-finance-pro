                <mxCell id="21" value="`destinationAccount` is optional because it&#39;s possible to be making a contribution to something not covered by this model. That&#39;s OK since these are tracked for reporting only." style="shape=note2;boundedLbl=1;whiteSpace=wrap;html=1;size=25;verticalAlign=top;align=center;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" parent="wVVx1cMErQA-93AqkkJT-1" vertex="1">
